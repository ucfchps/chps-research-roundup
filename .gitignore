# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# backfill acceptance test (§13.24) — a throwaway, clean-room-only scratch DB.
# Never the production database; safe to delete and re-create at any time.
/.scratch

# Session 21: full production DB dumps taken before the operational backfill.
# Contains real faculty PII (email addresses) — never committed.
/backups

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
